extends RefCounted
# Tile pixels sampled from the original generated dark-fantasy PNG atlas.
# Text-encoded RGB pixel art because the GitHub integration accepts UTF-8 files only.
const PALETTES = [["#5d6270","#505769","#4d5364","#4a5263","#494f60","#474e5e","#464c5c","#434958","#414756","#3f4453","#393e4a","#292c35"],["#6a6c32","#5a5c2b","#545629","#4d5428","#4f4f29","#484e25","#434a23","#474325","#3d4321","#373d1e","#38331e","#1a160e"],["#61416d","#5a2f5d","#5f2a5a","#45294d","#51254f","#3e2243","#4c1c45","#3b1c3a","#2a1a31","#251329","#0e080f","#010001"],["#795f50","#664c3f","#624333","#534139","#573c2f","#4d392f","#4e352a","#49342b","#42322b","#3e2c25","#332a28","#1d1716"],["#6c737e","#5c6372","#4c5159","#3c424f","#353a45","#2b303a","#232834","#202530","#1c212b","#171b22","#11141b","#0a0c10"]]
const PIXELS = ["","","","",""]

static func build() -> Array[Texture2D]:
    var results: Array[Texture2D] = []
    for i in range(PIXELS.size()):
        var img := Image.create(20,20,false,Image.FORMAT_RGBA8)
        var chars: String = PIXELS[i]
        for y in range(20):
            for x in range(20):
                var digit: String = chars.substr(y * 20 + x,1)
                var index: int = "0123456789ab".find(digit)
                img.set_pixel(x,y,Color.html(PALETTES[i][index]))
        var texture := ImageTexture.create_from_image(img)
        results.append(texture)
    return results
