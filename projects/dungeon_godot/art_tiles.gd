extends RefCounted
# Tile pixels sampled from the original generated dark-fantasy PNG atlas.
# Text-encoded RGB pixel art because the GitHub integration accepts UTF-8 files only.
const PALETTES = [["#2a2e36","#22262d","#1c2026","#161a1f","#3a3f48","#4a5060","#5a6350","#3d4636","#6a7b55","#1a1e26","#101218","#080a0c"],["#2d382a","#252f22","#1e261c","#161c15","#3d4a38","#4a5a3c","#5a6b48","#2a3324","#6a7b55","#1a2016","#0e120c","#080a06"],["#1c2026","#161a1f","#101318","#0a0c0f","#2a2e36","#323741","#3a3f48","#1a1e26","#4a5060","#101218","#080a0c","#040506"],["#2a1e1c","#221816","#1a1210","#120c0a","#3a2a28","#4a2828","#5a3030","#2a1818","#6a3838","#1a1010","#0e0808","#060404"],["#1c2530","#161e28","#101820","#0a1018","#2a3540","#324050","#3a4a5a","#1a2830","#4a5a6a","#101820","#080c10","#040608"]]
const PIXELS = ["","","","",""]

static func build() -> Array[Texture2D]:
    var results: Array[Texture2D] = []
    for i in range(PIXELS.size()):
        var img := Image.create(20,20,false,Image.FORMAT_RGBA8)
        var chars: String = PIXELS[i]
        for y in range(20):
            for x in range(20):
                var digit: String = chars.substr(y * 20 + x,1)
                var index: int = "0123456789ab".find(digit)
                img.set_pixel(x,y,Color.html(PALETTES[i][index]))
        var texture := ImageTexture.create_from_image(img)
        results.append(texture)
    return results
